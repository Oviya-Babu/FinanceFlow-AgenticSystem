# FastAPI Configuration
FASTAPI_ENV=development
FASTAPI_DEBUG=true
FASTAPI_HOST=0.0.0.0
FASTAPI_PORT=8000

# Ollama Configuration
OLLAMA_HOST=http://localhost:11434
OLLAMA_MODEL=llama3.2:3b
# Alternative: phi3:mini

# Redis Configuration
REDIS_HOST=redis
REDIS_PORT=6379
REDIS_DB=0
REDIS_PASSWORD=financeflow-secure-password-change-in-production

# SQLite Configuration
SQLITE_DB_PATH=./data/financeflow.db

# OpenTelemetry Configuration
OTEL_ENABLED=true
OTEL_EXPORTER_OTLP_ENDPOINT=http://localhost:4317
OTEL_JAEGER_ENABLED=true
JAEGER_AGENT_HOST=localhost
JAEGER_AGENT_PORT=6831

# Prometheus Configuration
PROMETHEUS_ENABLED=true
PROMETHEUS_PORT=9090

# Logging Configuration
LOG_LEVEL=INFO
LOG_FORMAT=json

# Application Configuration
APP_NAME=FinanceFlow
APP_VERSION=1.0.0
APP_DESCRIPTION=Enterprise Autonomous Financial Research & Reporting Platform

# Security (for future AgentGuard-X integration)
ENABLE_OBSERVABILITY_HOOKS=true
ENABLE_TOOL_INTERCEPTION_HOOKS=true
ENABLE_TRAFFIC_CORRELATION=true
