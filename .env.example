# ============================================================
# AgentGuard Environment Variables — Example / Template
# ============================================================
# INSTRUCTIONS:
#   1. Copy this file:  cp .env.example .env
#   2. Replace every CHANGE_ME_* placeholder with real values.
#   3. Generate passwords: openssl rand -base64 32
#   4. NEVER commit .env to version control.
# ============================================================

REDIS_HOST=localhost
REDIS_PORT=6379
REDIS_PASSWORD=CHANGE_ME_generate_with_openssl_rand_base64_32
REDIS_SSL=false

OPA_URL=http://localhost:8181
OPA_POLICY_PATH=/v1/data/agentguard/authz

TRIAGE_SERVICE_URL=http://localhost:8000
TRIAGE_PORT=8000

OLLAMA_BASE_URL=http://localhost:11434
OLLAMA_MODEL=llama3.2

FAST_PATH_THRESHOLD=0.30
INSTANT_KILL_THRESHOLD=0.80
STAGE2_INSTANT_KILL=0.95

WEIGHT_SIGNATURE=0.35
WEIGHT_POLICY=0.30
WEIGHT_SEMANTIC=0.20
WEIGHT_DRIFT=0.15

CORROBORATION_THRESHOLD=2
CORROBORATION_MULTIPLIER=1.25

CHROMA_COLLECTION=threat_patterns
EMBEDDING_MODEL=all-MiniLM-L6-v2
RAG_TOP_K=5
RAG_SIMILARITY_THRESHOLD=0.65

SANDBOX_IMAGE=python:3.11-slim
SANDBOX_TIMEOUT=30
SANDBOX_MEMORY=256m

DEMO_SESSION_ID=financeflow-demo-001

OTEL_SERVICE_NAME=agentguard
TRIAGE_ALLOWED_ORIGINS=http://localhost:3000,http://localhost:8000,http://localhost:8001

GRAFANA_ADMIN_USER=admin
GRAFANA_ADMIN_PASSWORD=CHANGE_ME_generate_with_openssl_rand_base64_24

HOST=127.0.0.1
PORT=8000
