# ─────────────────────────────────────────────
#  FinanceFlow + AgentGuard-X environment vars
#  Copy to .env and edit as needed.
#  FinanceFlow reads this via pydantic-settings.
# ─────────────────────────────────────────────

# Ollama (LLM backend)
OLLAMA_HOST=http://localhost:11434
OLLAMA_MODEL=llama3.2:3b
OLLAMA_TEMPERATURE=0.7
OLLAMA_TOP_P=0.9
OLLAMA_MAX_TOKENS=2048

# Redis
REDIS_HOST=localhost
REDIS_PORT=6379
REDIS_DB=0
# REDIS_PASSWORD=your_password_here

# SQLite
SQLITE_DB_PATH=./data/financeflow.db

# FastAPI
FASTAPI_ENV=development
FASTAPI_DEBUG=true
FASTAPI_HOST=0.0.0.0
FASTAPI_PORT=8000
FASTAPI_RELOAD=false

# Observability (OTel / Jaeger)
OTEL_ENABLED=true
OTEL_JAEGER_ENABLED=false

# Prometheus
PROMETHEUS_ENABLED=true
PROMETHEUS_PORT=9090

# Logging
LOG_LEVEL=INFO
LOG_FORMAT=text

# Safety gates — keep true unless you really want live email / agent spawning
APP_SIMULATION_MODE=true
APP_ALLOW_EXTERNAL_EMAIL=false
APP_ALLOW_AGENT_SPAWNING=false
