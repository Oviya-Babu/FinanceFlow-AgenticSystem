{
  "annotations": {
    "list": [
      {
        "builtIn": 1,
        "datasource": "-- Grafana --",
        "enable": true,
        "hide": true,
        "iconColor": "rgba(0, 211, 255, 1)",
        "name": "Annotations & Alerts",
        "type": "dashboard"
      }
    ]
  },
  "description": "Detailed policy enforcement breakdown with decision traces and rule analysis",
  "editable": true,
  "fiscalYearStartMonth": 0,
  "graphTooltip": 0,
  "id": 2,
  "links": [],
  "liveNow": true,
  "panels": [
    {
      "datasource": "Prometheus",
      "fieldConfig": {
        "defaults": {
          "custom": {
            "align": "auto",
            "displayMode": "auto",
            "inspect": false
          },
          "mappings": [],
          "unit": "short"
        },
        "overrides": []
      },
      "gridPos": {
        "h": 12,
        "w": 24,
        "x": 0,
        "y": 0
      },
      "id": 10,
      "options": {
        "showHeader": true,
        "sortBy": [
          {
            "displayName": "Timestamp",
            "desc": true
          }
        ]
      },
      "pluginVersion": "9.0.0",
      "targets": [
        {
          "expr": "topk(50, opa_decisions_total)",
          "format": "table",
          "instant": true,
          "refId": "A"
        }
      ],
      "title": "Recent OPA Decision Trace (Last 50 Decisions)",
      "transformations": [
        {
          "id": "organize",
          "options": {
            "excludeByName": {
              "Time": false,
              "__name__": true,
              "job": true,
              "instance": true
            },
            "indexByName": {},
            "renameByName": {
              "agent_role": "Agent Role",
              "tool_name": "Tool Requested",
              "verdict": "Decision",
              "Value": "Count"
            }
          }
        }
      ],
      "type": "table"
    },
    {
      "datasource": "Prometheus",
      "fieldConfig": {
        "defaults": {
          "custom": {
            "hideFrom": {
              "tooltip": false,
              "viz": false,
              "legend": false
            }
          },
          "mappings": [],
          "unit": "short"
        },
        "overrides": []
      },
      "gridPos": {
        "h": 8,
        "w": 12,
        "x": 0,
        "y": 12
      },
      "id": 11,
      "options": {
        "displayLabels": ["value"],
        "legend": {
          "displayMode": "list",
          "placement": "bottom",
          "values": ["value"]
        },
        "pieType": "donut",
        "tooltip": {
          "mode": "single",
          "sort": "none"
        }
      },
      "pluginVersion": "9.0.0",
      "targets": [
        {
          "expr": "sum(opa_denials_by_reason) by (reason)",
          "format": "time_series",
          "intervalFactor": 2,
          "legendFormat": "{{ reason }}",
          "refId": "A"
        }
      ],
      "title": "Deny Reason Distribution",
      "type": "piechart"
    },
    {
      "datasource": "Prometheus",
      "fieldConfig": {
        "defaults": {
          "custom": {
            "lineWidth": 1,
            "fillOpacity": 10,
            "gradientMode": "none",
            "hideFrom": {
              "tooltip": false,
              "viz": false,
              "legend": false
            }
          },
          "unit": "short"
        },
        "overrides": []
      },
      "gridPos": {
        "h": 8,
        "w": 12,
        "x": 12,
        "y": 12
      },
      "id": 12,
      "options": {
        "legend": {
          "displayMode": "table",
          "placement": "right",
          "calcs": ["mean", "max"]
        },
        "tooltip": {
          "mode": "multi",
          "sort": "none"
        }
      },
      "pluginVersion": "9.0.0",
      "targets": [
        {
          "expr": "sum(rate(opa_rule_evaluation_time_ms_bucket[5m])) by (rule_name)",
          "format": "time_series",
          "intervalFactor": 2,
          "legendFormat": "{{ rule_name }}",
          "refId": "A"
        }
      ],
      "title": "Rule Evaluation Performance",
      "type": "timeseries"
    }
  ],
  "refresh": "10s",
  "schemaVersion": 37,
  "style": "dark",
  "tags": ["agentguard", "opa", "policy", "enforcement"],
  "templating": {
    "list": []
  },
  "time": {
    "from": "now-1h",
    "to": "now"
  },
  "timepicker": {},
  "timezone": "",
  "title": "AgentGuard-X OPA Policy Enforcement Details",
  "uid": "opa-policy-enforcement",
  "version": 1
}
