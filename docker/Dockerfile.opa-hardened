# Hardened OPA Dockerfile for Security Mesh
# Base: Distroless (minimal attack surface)
# Implements: Security scanning, non-root, capability dropping

ARG OPA_VERSION=0.62.0
FROM openpolicyagent/opa:${OPA_VERSION} as builder

# Verify OPA binary integrity
RUN opa version

# Final image: Distroless for minimal attack surface
FROM gcr.io/distroless/base-debian12:nonroot

# Copy OPA binary from official image
COPY --from=builder /opa /bin/opa

# Create directory for policies (read-only after startup)
RUN mkdir -p /policies

# Copy security policies
COPY --chown=nonroot:nonroot policies/ /policies/

# Copy OPA configuration
COPY --chown=nonroot:nonroot opa-hardened.conf /etc/opa/

# Security labels
LABEL security.vendor="AgentGuard" \
      security.level="critical" \
      security.image="distroless" \
      security.attack-surface="minimal" \
      security.scanning="enabled" \
      audit.enabled="true"

# Security annotations
LABEL description="Hardened OPA for security mesh" \
      maintainer="AgentGuard Security Team" \
      security-policy="zero-trust"

# Health check (runs as nonroot)
HEALTHCHECK --interval=10s --timeout=5s --start-period=5s --retries=3 \
    CMD /bin/opa run --help || exit 1

# User is already nonroot (UID 65532) from distroless
USER 65532:65532

# Read-only filesystem (except /tmp for transient data)
# Use --read-only --tmpfs /tmp when running

# Expose OPA port
EXPOSE 8181

# Run OPA with strict security settings
ENTRYPOINT ["/bin/opa"]
CMD ["run", "--server", \
     "--log-level=debug", \
     "--config=/etc/opa/opa-hardened.conf", \
     "/policies"]

# Security Note:
# - Runs as nonroot user (65532:65532)
# - Distroless base: only libc and ca-certificates
# - No shell, no package manager in runtime image
# - Cannot be exploited to install tools
# - Every file is verified by distroless
