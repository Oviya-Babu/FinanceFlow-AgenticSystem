# ============================================================
# Hardened Redis Dockerfile for AgentGuard Security Mesh
# Base: Alpine Linux with security patches
# HARDENED 2026-05-27:
#   V24 — fixed "apk cache clean" → "rm -rf /var/cache/apk/*"
#          (apk cache clean is not a valid apk subcommand)
# ============================================================

ARG ALPINE_VERSION=3.19.1

# ── Stage 1: Build Redis from verified source ─────────────────
FROM alpine:${ALPINE_VERSION} AS builder

# FIX V24: use correct cache cleanup; apk cache clean is invalid
RUN apk add --no-cache \
        wget \
        ca-certificates \
        openssl \
        make \
        gcc \
        libc-dev \
        linux-headers \
    && rm -rf /var/cache/apk/*

# Download and verify Redis source
ARG REDIS_VERSION=7.2.4
# SHA256 of redis-7.2.4.tar.gz (verify at https://download.redis.io/releases/)
ARG REDIS_SHA256=8d104c26a154b29fd67d6568b4f9c74fe2498550a50603a3a5f9c7b4b0ff5bef

RUN wget -q "https://download.redis.io/releases/redis-${REDIS_VERSION}.tar.gz" \
    && echo "${REDIS_SHA256}  redis-${REDIS_VERSION}.tar.gz" | sha256sum -c - \
    && tar xzf "redis-${REDIS_VERSION}.tar.gz" \
    && cd "redis-${REDIS_VERSION}" \
    && make -j"$(nproc)" \
    && make install PREFIX=/usr/local \
    && rm -rf "redis-${REDIS_VERSION}.tar.gz" "redis-${REDIS_VERSION}"

# ── Stage 2: Minimal runtime image ────────────────────────────
FROM alpine:${ALPINE_VERSION}

# Install only runtime dependencies
# FIX V24: proper cache cleanup
RUN apk add --no-cache \
        ca-certificates \
        openssl \
    && apk upgrade --no-cache \
    && rm -rf /var/cache/apk/*

# Copy Redis binaries from builder
COPY --from=builder /usr/local/bin/redis-server /usr/local/bin/redis-server
COPY --from=builder /usr/local/bin/redis-cli    /usr/local/bin/redis-cli

# Create non-root user for Redis
RUN addgroup -S -g 999 redis && adduser -S -u 999 -G redis redis

# Create data and log directories
RUN mkdir -p /data /var/log/redis \
    && chown -R redis:redis /data /var/log/redis

# Secure binary permissions
RUN chmod 755 /usr/local/bin/redis-server \
    && chmod 755 /usr/local/bin/redis-cli

# Copy hardened Redis configuration
COPY --chown=redis:redis redis-hardened.conf /etc/redis/

# Copy ACL file (users and permissions)
COPY --chown=redis:redis users.acl /etc/redis/

# Lock down config file permissions
RUN chmod 600 /etc/redis/redis-hardened.conf \
    && chmod 600 /etc/redis/users.acl

# Security labels
LABEL security.vendor="AgentGuard" \
      security.level="critical" \
      security.policy="minimal-footprint" \
      security.scanning="enabled" \
      audit.enabled="true"

# Health check — authenticate with password from env if set
HEALTHCHECK --interval=10s --timeout=3s --start-period=5s --retries=3 \
    CMD redis-cli -a "${REDIS_PASSWORD:-}" ping || exit 1

# Switch to non-root user
USER redis:redis

# Expose port (Docker network provides isolation; host binding via Compose)
EXPOSE 6379

# Run Redis — the REDIS_PASSWORD env var is passed via --requirepass at runtime
# so the conf file's placeholder is overridden
ENTRYPOINT ["redis-server", "/etc/redis/redis-hardened.conf"]

# Security:
# - Non-root user (redis:redis, UID/GID 999)
# - Read-only root FS (use --read-only in Compose)
# - Config and ACL files chmod 600
# - All dangerous commands renamed/disabled in redis-hardened.conf
